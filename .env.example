# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Resend API key for the contact form (resend.com -> API Keys). Server-only: no NEXT_PUBLIC_ prefix.
RESEND_API_KEY=

# Upstash Redis for the Sky Hop leaderboard (upstash.com -> create a Redis database -> REST API section).
# Server-only. Without them the game works, just with no shared top 5.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
